NODE_ENV=development
PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/event_florist?replicaSet=rs0
SESSION_SECRET=replace-with-a-random-secret-at-least-32-characters
# lax | strict | none. Use "none" only when the frontend and the API are on
# different registrable domains (cookies then require HTTPS in every env).
SESSION_COOKIE_SAMESITE=strict
# Trusted browser origins, comma separated. The API rejects CORS requests from
# any other origin when credentials are used.
FRONTEND_ORIGIN=http://localhost:3000
ADMIN_EMAIL=admin@example.com
ADMIN_NAME=Event Florist Admin
ADMIN_PASSWORD=replace-with-a-strong-password
